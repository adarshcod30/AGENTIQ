# AGENTIQ environment template
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env
#
# Every variable below is validated with Zod at boot (server/src/config/env.js).
# The server prints a table of what is set and what is missing, then exits
# non-zero if a REQUIRED variable is absent.
#
# Source of truth: docs/02_TRD.md §12.


# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# REQUIRED. MongoDB connection string. Atlas M0 free tier is sufficient.
MONGO_URI=

# REQUIRED. No default exists and none will be added: boot fails without it.
# Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=


# ── Origins ───────────────────────────────────────────────────────────────────
# Locked to the deployed origin in production; never hardcoded in source.
CORS_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3001


# ── LLM providers ─────────────────────────────────────────────────────────────
# BEDROCK IS PRIMARY, Groq is the fallback (docs/05_AWS_ARCHITECTURE.md).
# Chosen on measurement, not preference: Bedrock Nova Lite is ~3.5x cheaper per
# generation, faster, has no free-tier tokens-per-minute limit, and scored
# higher on the evaluation harness (docs/90_EVALUATION.md).
#
# WATCH OUT: providerOrder() silently DROPS a provider whose credentials or
# model id are missing. Naming bedrock here without BEDROCK_MODEL_ID leaves a
# one-provider chain with no fallback, which looks configured and is not. The
# server warns at boot, and GET /api/health reports the chain that will really
# be used.
#
# Pollinations is deliberately NOT supported: an unauthenticated third-party
# LLM proxy has no place in a security project. See docs/01_PRD.md §8.
LLM_PRIMARY=bedrock
LLM_FALLBACK=groq

# Bedrock's model id is set in the AWS section below, beside the credentials it
# needs. Declaring it twice would leave the last one silently winning.
# Optional per-task override; see TASK_MODELS in server/src/services/llm.js.
# BEDROCK_MODEL_EXPLAIN=apac.amazon.nova-lite-v1:0

# Groq fallback. Free tier. Providers retire models on their own schedule,
# llama-3.1-8b-instant was withdrawn mid-project and every generation started
# failing with an opaque 404, which is why this is configurable.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODEL_EXPLAIN=openai/gpt-oss-20b

# ── Google OAuth (OPTIONAL) ───────────────────────────────────────────────────
# The server MUST boot fully with these unset. The Passport strategy registers
# lazily, only when both are present.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── Email verification (optional) ─────────────────────────────────────────────
# Absence disables verification MAIL, not the app: registration still succeeds,
# the account is created unverified, and outside production the link is written
# to the log and returned in the register response so you can continue.
#
# Verification is SOFT by design: an unverified user can sign in and use
# everything, and the UI shows a banner with a resend button. A demo that a spam
# filter can lock you out of is worse than an advisory one.
#
# Full walkthrough: docs/06_SETUP_AUTH.md
#
# ── Option A: Gmail SMTP (sends to ANYONE, needs no domain) ───────────────────
# Requires 2-Step Verification on the account, then an App Password from
# https://myaccount.google.com/apppasswords
# Paste the 16 characters exactly as Google shows them: spaces are stripped
# for you, so "abcd efgh ijkl mnop" is fine.
MAIL_DRIVER=smtp
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Option B: Resend ─────────────────────────────────────────────────────────
# ⚠ THE FREE TIER ONLY SENDS TO THE ACCOUNT OWNER'S OWN ADDRESS. With the
# shared onboarding@resend.dev sender every other recipient is refused with
# 403 "You can only send testing emails to your own email address". Verifying a
# domain at resend.com/domains lifts that and requires a domain you control.
# MAIL_DRIVER=resend
# RESEND_API_KEY=

# From address. Defaults to your Gmail on the smtp driver: Gmail will not let
# you send as an address you do not own.
# MAIL_FROM=AGENTIQ <you@gmail.com>

# Any other SMTP provider, as a single URL (overrides GMAIL_* above).
# SMTP_URL=smtps://user:password@smtp.example.com:465


# ── Deployment (OPTIONAL) ─────────────────────────────────────────────────────
# Only needed for the Deployment Agent (F5). Stored encrypted, never logged,
# never returned to the client.
RENDER_API_KEY=


# ── Logging (optional) ────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal | silent
# Defaults to debug in development and info in production. Validated at boot, so
# a typo fails with a readable message rather than an error from inside pino.
LOG_LEVEL=

# ── Egress guard (SSRF) ───────────────────────────────────────────────────────
# See docs/02_TRD.md §7. Every outbound request passes through mcp/egress.js.
EGRESS_TIMEOUT_MS=10000
EGRESS_MAX_BYTES=5242880
EGRESS_RPS_PER_HOST=5

# Escape hatch for testing against the local fixture apps (fixtures/).
# Default OFF. Refused outright when NODE_ENV=production.
ALLOW_PRIVATE_TARGETS=false


# ── AWS (OPTIONAL) ────────────────────────────────────────────────────────────
# See docs/05_AWS_ARCHITECTURE.md. Every variable here is optional and the
# server MUST boot fully without them, exactly like the Google OAuth block.
#
# NOTE: there is deliberately no AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here.
# Locally the default credential chain reads ~/.aws/credentials; on App Runner an
# instance role supplies them; in CI they come from GitHub OIDC. A long-lived AWS
# key should never be written to a file in this repository.
AWS_REGION=ap-south-1

# Bedrock model, as an INFERENCE PROFILE id (global./apac./us. prefix), not a
# bare model id. Amazon Nova is the deliberate default: AWS first-party, so it
# needs no Marketplace subscription, and Nova Lite is ~4x cheaper than Claude
# Haiku and ~50x cheaper than Sonnet. See docs/05_AWS_ARCHITECTURE.md.
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0


# ── Frontend ──────────────────────────────────────────────────────────────────
# Read by web/src/services/api.ts via import.meta.env.VITE_API_URL. The API
# origin is never hardcoded in the client; a localhost literal would make the
# app undeployable.
VITE_API_URL=http://localhost:3001/api
