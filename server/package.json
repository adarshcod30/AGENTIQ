    "mcp:stdio": "node src/mcp/stdio.js"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1111.0",
    "@babel/parser": "^7.29.8",
    "@modelcontextprotocol/sdk": "1.30.0",
    "axios": "1.19.0",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "js-yaml": "4.3.2",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.9.2",
    "nodemailer": "^9.1.1",
    "passport": "0.7.0",
    "passport-google-oauth20": "2.0.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "mongodb-memory-server": "11.2.0",
