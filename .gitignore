# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
.pnp
.pnp.js

# ── Build output ──────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
*.tsbuildinfo

# ── Test / coverage ───────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Environment: never commit a real value ────────────────────────────────────
# .env.example IS committed; it is the template and holds no values.
.env
.env.*
!.env.example

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ── Editors ───────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.swp

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db

# ── Certificates / keys ───────────────────────────────────────────────────────
*.pem
*.key
*.p12

# Local editor and tool state. Never commit.
.claude/
.claude.json
CLAUDE.local.md

# local agent and editor files, never committed
CLAUDE.md
AGENTS.md

# secrets, build output and local noise
.env.local
.next/
