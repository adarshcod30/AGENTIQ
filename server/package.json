{
  "name": "agentiq-server",
  "private": true,
  "version": "1.0.0",
  "description": "AGENTIQ API server",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
